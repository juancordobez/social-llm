{
  "name": "social-mimic-backend",
  "version": "0.1.0",
  "description": "Backend APIs for Social Mimic AI agent",
  "main": "src/functions.js",
  "scripts": {
    "dev": "node src/dev-server.js",
    "dev:watch": "nodemon src/dev-server.js",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .js,.ts",
    "lint:fix": "eslint src/ --ext .js,.ts --fix",
    "deploy:dev": "npx serverless deploy --stage dev",
    "deploy:prod": "npx serverless deploy --stage prod",
    "logs": "gcloud functions logs read health --gen2",
    "info": "npx serverless info --stage dev"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.470.0",
    "@aws-sdk/client-s3": "^3.470.0",
    "@prisma/client": "^5.7.1",
    "@supabase/supabase-js": "^2.91.1",
    "@xenova/transformers": "^2.17.2",
    "aws-sdk": "^2.1500.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.7.1",
    "redis": "^4.6.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@google-cloud/functions-framework": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "serverless": "^3.38.0",
    "serverless-google-cloudfunctions": "^4.6.0",
    "serverless-offline": "^13.3.0",
    "serverless-webpack": "^5.13.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "ai",
    "social-media",
    "community-manager",
    "serverless"
  ],
  "author": "Juan Cordobez",
  "license": "MIT"
}
