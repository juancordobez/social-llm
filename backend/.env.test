# ===============================================
# Environment Variables - TEST
# ===============================================
# Este archivo configura el entorno de pruebas

NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# API Keys (usar valores de test o reales para integration tests)
GROQ_API_KEY=your-groq-api-key-for-testing
GROQ_MODEL=llama-3.3-70b-versatile

# Silenciar logs durante tests
SILENCE_LOGS=false

# Brain config
BRAIN_DEBUG=false
