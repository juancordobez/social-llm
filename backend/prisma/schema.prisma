// Social Mimic - Prisma Schema
// PostgreSQL Database Schema for AI Community Manager

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// USER & AUTHENTICATION
// ===========================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles Profile[]
  contents Content[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

// ===========================================
// SOCIAL MEDIA PROFILES
// ===========================================

model Profile {
  id          String       @id @default(cuid())
  userId      String
  platform    Platform
  username    String
  displayName String?
  bio         String?
  avatarUrl   String?
  accessToken String?      @db.Text
  refreshToken String?     @db.Text
  tokenExpiry DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personality Personality?
  contents    Content[]
  analytics   Analytics[]

  @@unique([platform, username])
  @@map("profiles")
}

enum Platform {
  TWITTER
  INSTAGRAM
  LINKEDIN
  TIKTOK
  FACEBOOK
  THREADS
}

// ===========================================
// AI PERSONALITY ANALYSIS
// ===========================================

model Personality {
  id              String   @id @default(cuid())
  profileId       String   @unique
  tone            String   // e.g., "professional", "casual", "humorous"
  style           String   // e.g., "engaging", "informative", "provocative"
  topics          String[] // Array of main topics
  vocabulary      Json?    // Frequent words and phrases
  postingPatterns Json?    // Timing and frequency patterns
  emojiUsage      Json?    // Emoji preferences
  hashtagStyle    Json?    // Hashtag preferences
  confidence      Float    @default(0.0) // Analysis confidence score
  analyzedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("personalities")
}

// ===========================================
// CONTENT GENERATION
// ===========================================

model Content {
  id           String        @id @default(cuid())
  userId       String
  profileId    String
  platform     Platform
  type         ContentType
  text         String        @db.Text
  mediaUrls    String[]
  hashtags     String[]
  mentions     String[]
  status       ContentStatus @default(DRAFT)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  externalId   String?       // ID from social media platform
  engagement   Json?         // Engagement metrics after publishing
  aiPrompt     String?       @db.Text // Original prompt used
  aiModel      String?       // Model used for generation
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("contents")
}

enum ContentType {
  POST
  STORY
  REEL
  THREAD
  CAROUSEL
  POLL
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  DELETED
}

// ===========================================
// ANALYTICS & METRICS
// ===========================================

model Analytics {
  id           String   @id @default(cuid())
  profileId    String
  date         DateTime @db.Date
  followers    Int      @default(0)
  following    Int      @default(0)
  posts        Int      @default(0)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  impressions  Int      @default(0)
  reach        Int      @default(0)
  engagement   Float    @default(0.0) // Engagement rate
  createdAt    DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@map("analytics")
}

// ===========================================
// VECTOR EMBEDDINGS (for RAG)
// ===========================================

model Embedding {
  id        String   @id @default(cuid())
  contentId String?
  type      String   // "content", "profile", "topic"
  text      String   @db.Text
  vector    Bytes    // Stored as binary for PostgreSQL
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("embeddings")
}

// ===========================================
// AUDIT & LOGS
// ===========================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
