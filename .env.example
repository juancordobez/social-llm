# ===========================================
# Social Mimic - Environment Configuration
# Stack B: $0/mes (GCP + Supabase + Upstash + Groq)
# ===========================================

# -------------------------------------------
# 🧠 AI Provider (Groq - FREE)
# Get your key: https://console.groq.com/keys
# Free tier: 30 req/min, 6000 req/day
# -------------------------------------------
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.1-70b-versatile"
AI_PROVIDER="groq"

# -------------------------------------------
# 🗄️ Database (Supabase - FREE)
# Get your keys: https://app.supabase.com/project/_/settings/api
# Free tier: 500MB PostgreSQL + pgvector
# -------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_KEY="your_supabase_service_key"
DATABASE_PROVIDER="supabase"

# -------------------------------------------
# 📦 Cache (Upstash Redis - FREE)
# Get your keys: https://console.upstash.com/redis
# Free tier: 10,000 commands/day
# -------------------------------------------
UPSTASH_REDIS_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_TOKEN="your_upstash_token"
CACHE_PROVIDER="upstash"

# -------------------------------------------
# ☁️ Google Cloud (Compute - FREE tier)
# Cloud Functions: 2M invocations/month free
# -------------------------------------------
GCP_PROJECT="your_gcp_project_id"
GCP_REGION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="~/.config/gcloud/application_default_credentials.json"

# -------------------------------------------
# 📱 Social Media APIs (Configure when needed)
# -------------------------------------------
TWITTER_API_KEY="your_twitter_api_key"
TWITTER_API_SECRET="your_twitter_api_secret"
TWITTER_ACCESS_TOKEN="your_twitter_access_token"
TWITTER_ACCESS_TOKEN_SECRET="your_twitter_access_token_secret"

LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

# -------------------------------------------
# 🔧 Server Configuration
# -------------------------------------------
PORT=3000
CORS_ORIGIN="*"

# JWT Authentication
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# Environment
NODE_ENV="development"
LOG_LEVEL="debug"
ENVIRONMENT="local"
